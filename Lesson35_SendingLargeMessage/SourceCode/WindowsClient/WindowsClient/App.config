<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
    </startup>
    <system.serviceModel>
        <bindings>
            <wsHttpBinding>
                <binding name="WSHttpBinding_IDownloadService" maxReceivedMessageSize="700000000" messageEncoding="Mtom">
                    <readerQuotas maxArrayLength="700000000"/>
                </binding>
            </wsHttpBinding>
        </bindings>
        <client>
            <endpoint address="http://downloadservice.net:7381/DownloadService.svc/DownloadService.svc"
                binding="wsHttpBinding" bindingConfiguration="WSHttpBinding_IDownloadService"
                contract="DownloadService.IDownloadService" name="WSHttpBinding_IDownloadService">
                <identity>
                    <servicePrincipalName value="host/WLECNSHA1-10023.asnet.accorservices.net" />
                </identity>
            </endpoint>
        </client>
    </system.serviceModel>
</configuration>