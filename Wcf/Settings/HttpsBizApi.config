<?xml version="1.0" encoding="utf-8"?>

<configuration> 
  <configSections> 
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler"/> 
  </configSections>  
  <appSettings> 
    <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true"/> 
  </appSettings>  
  <system.web> 
    <compilation targetFramework="4.5"/>  
    <httpRuntime targetFramework="4.5"/> 
  </system.web>  
  <system.serviceModel> 
    <services> 
      <service name="eVoucher.Mo.Api.Public.PublicService"> 
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="HttpsBinding" bindingNamespace="http://ticketxpress.com.tw/" contract="eVoucher.Mo.Api.Common.IPublicService"/> 
      </service> 
    </services>  
    <bindings> 
      <basicHttpBinding> 
        <binding name="BasicHttpBinding_IPublicService"/>  
        <binding name="HttpsBinding"> 
          <security mode="Transport"> 
            <transport clientCredentialType="None"/> 
          </security> 
        </binding> 
      </basicHttpBinding> 
    </bindings>  
    <client> 
      <endpoint address="http://mointernalapi-sg.prod.edenred.net/ProxyService.svc" binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IPublicService" contract="ProxyService.IPublicService" name="BasicHttpBinding_IPublicService"/> 
    </client>  
    <behaviors> 
      <serviceBehaviors> 
        <behavior> 
          <!-- To avoid disclosing metadata information, set the values below to false before deployment -->  
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true"/>  
          <!-- To receive exception details in faults for debugging purposes, set the value below to true.  Set to false before deployment to avoid disclosing exception information -->  
          <serviceDebug includeExceptionDetailInFaults="false"/> 
        </behavior> 
      </serviceBehaviors> 
    </behaviors>  
    <protocolMapping> 
      <add binding="basicHttpsBinding" scheme="https"/> 
    </protocolMapping>  
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true"/> 
  </system.serviceModel>  
  <system.webServer> 
    <modules runAllManagedModulesForAllRequests="true"/>  
    <defaultDocument> 
      <files> 
        <add value="PublicService.svc"/> 
      </files> 
    </defaultDocument>  
    <directoryBrowse enabled="false"/> 
  </system.webServer>  
  <log4net> 
    <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender"> 
      <file value="E:\WWWRoot\Log\SG_EV_WEB_MOAPI\eVoucher.Mo.Api.Public.log"/>  
      <appendToFile value="true"/>  
      <rollingStyle value="Size"/>  
      <maxSizeRollBackups value="500"/>  
      <maximumFileSize value="10MB"/>  
      <staticLogFileName value="true"/>  
      <layout type="log4net.Layout.SimpleLayout"/> 
    </appender>  
    <root> 
      <level value="ALL"/>  
      <appender-ref ref="RollingFileAppender"/> 
    </root> 
  </log4net> 
</configuration>
