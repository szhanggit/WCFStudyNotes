<?xml version="1.0" encoding="utf-8"?>
<!--SG Prod Adora Proxy Service 186-->
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
    <section name="ProgramConfig" type="eVoucher.PosProxy.BLL.ProgramConfig, POSProxy.BLL" />
  </configSections>
  <appSettings>
    <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true" />
    <add key="ValidationFilePath" value="bin\DataValidationRules.xml" />
    <add key="SupportLanguage" value="en" />
  </appSettings>
  <system.web>
    <compilation targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" />

  </system.web>
  <system.serviceModel>
    <services>
      <service name="eVoucher.Authorization.WcfService.POSProxyService">
        <endpoint address="" binding="basicHttpBinding" bindingNamespace="http://ticketxpress.com.tw/" contract="eVoucher.Authorization.WcfService.IPOSProxy" />
      </service>
      <service name="eVoucher.Authorization.WcfService.BatchPosProxyService">
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IBatchPosProxy" bindingNamespace="http://ticketxpress.com.tw/" contract="eVoucher.Authorization.WcfService.IBatchPosProxy" />
      </service>
    </services>
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_IAuthorization" />
        <binding name="BasicHttpBinding_IBatchPosProxy" closeTimeout="00:10:00"
          receiveTimeout="00:20:00" sendTimeout="00:20:00" maxBufferSize="2147483647"
          maxReceivedMessageSize="2147483647" />
		<binding name="BasicHttpBinding_IPOSApiLogService" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://sgs-adorapaymentservice.prod.edenred.apacs/AuthorizationService.svc" binding="basicHttpBinding" contract="AuthorizationService.IAuthorization" name="AuthorizationService" />
      <endpoint address="http://sgs-adorapaymentservice.prod.edenred.apacs/POSApiLogService.svc" binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IPOSApiLogService"
                contract="POSApiLogService.IPOSApiLogService" name="BasicHttpBinding_IPOSApiLogService" />
    </client>
    <behaviors>
      <serviceBehaviors>
        <behavior>
          <!-- To avoid disclosing metadata information, set the values below to false before deployment -->
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true" />
          <!-- To receive exception details in faults for debugging purposes, set the value below to true.  Set to false before deployment to avoid disclosing exception information -->
          <serviceDebug includeExceptionDetailInFaults="true" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <protocolMapping>
      <add binding="basicHttpsBinding" scheme="https" />
    </protocolMapping>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true" />
  </system.serviceModel>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true">
    </modules>
    <!--
        To browse web app root directory during debugging, set the value below to true.
        Set to false before deployment to avoid disclosing web app folder information.
      -->
    <directoryBrowse enabled="false" />
    
  </system.webServer>
  <log4net>
    <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="D:\wwwroot\log\SG_EV_WEB_POSPSG1\pospservice.prod.edenred.apacs.log" />
      <appendToFile value="true" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="1MB" />
      <staticLogFileName value="true" />
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%newline%date [%thread] %-5level %logger [%property{NDC}] - %message%newline%newline%newline" />
      </layout>
    </appender>
    <!--<appender name="SmtpAppender" type="log4net.Appender.SmtpAppender">
      <to value="ERCN-eVoucherSupport@edenred.com" />
      <from value="sa-syg-guest-CN@edenred.com" />
      <subject value="eVoucher ADORA POS Exception##PROD##SGS" />
      <smtpHost value="172.30.115.28" />
      <authentication value="Basic" />
      <username value="asnet\sa-syg-guest" />
      <password value="abc1234$" />
      <bufferSize value="1" />
      <port value="25" />
      <lossy value="true" />
      <evaluator type="log4net.Core.LevelEvaluator">
        <threshold value="WARN" />
      </evaluator>
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%newline%date [%thread] %-5level %logger [%property{NDC}] - %message%newline%newline%newline" />
      </layout>
    </appender>-->
    <root>
      <level value="ALL" />
      <appender-ref ref="RollingFileAppender" />
      <!--<appender-ref ref="SmtpAppender" />-->
    </root>
  </log4net>
  <ProgramConfig>
    <add ProgramCode="000000000000000" />
  </ProgramConfig>
</configuration>
