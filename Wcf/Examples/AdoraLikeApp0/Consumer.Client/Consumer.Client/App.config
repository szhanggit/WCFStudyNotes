<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="BasicHttpBinding_IAdminAuthorize" />
                <binding name="BasicHttpBinding_IConsume" />
                <binding name="BasicHttpBinding_IConsumerCacheManagement" />
                <binding name="BasicHttpBinding_IConsumerCacheManagement1" />
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="http://localhost:8000/AuthorizationAdminService.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IAdminAuthorize"
                contract="AuthorizationAdminService.IAdminAuthorize" name="BasicHttpBinding_IAdminAuthorize" />
            <endpoint address="http://localhost:8000/ConsumerService.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IConsumerCacheManagement"
                contract="ConsumerService.IConsumerCacheManagement" name="BasicHttpBinding_IConsumerCacheManagement" />
            <endpoint address="http://localhost:8000/ConsumerService.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IConsume"
                contract="ConsumerService.IConsume" name="BasicHttpBinding_IConsume" />
        </client>
    </system.serviceModel>
</configuration>