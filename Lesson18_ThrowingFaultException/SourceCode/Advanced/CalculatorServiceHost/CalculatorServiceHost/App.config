<?xml version="1.0"?>
<configuration>
<system.serviceModel>
  <services>
    <service name="CalculatorService.CalculatorService" 
              behaviorConfiguration="mexBehavior">
      <endpoint address="CalculatorService" binding="basicHttpBinding" 
                contract="CalculatorService.ICalculatorService">     
      </endpoint>
      <host>
        <baseAddresses>
          <add baseAddress="http://localhost:8034/"/>
        </baseAddresses>
      </host>
    </service>
  </services>
  <behaviors>
    <serviceBehaviors>
      <behavior name="mexBehavior">
        <serviceMetadata httpGetEnabled="true"/>
        <serviceDebug includeExceptionDetailInFaults="true"/>
      </behavior>
    </serviceBehaviors>
  </behaviors>
</system.serviceModel>
</configuration>